NODE_ENV=development
PORT=3000

DATABASE_URL="mysql://user:password@localhost:3306/podcast_editor"
DATA_DIR=/data
FILE_URL_SECRET=your-secret-key-for-hmac

OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_DIARIZE_MODEL=gpt-4-turbo
OPENAI_LLM_MODEL=gpt-4-turbo

MIN_FREE_DISK_GB=10
EXPORT_CONCURRENCY=4

LIMIT_MAX_SIZE_BYTES=2147483648
LIMIT_MAX_DURATION_MS=7200000
LIMIT_RETENTION_HOURS=24
LIMIT_EXPORTS=10
LIMIT_AI_ANALYSES=5

THROTTLE_LIMIT=50
THROTTLE_TTL=60000
