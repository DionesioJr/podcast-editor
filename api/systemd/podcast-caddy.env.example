# Copie para /etc/podcast-editor/caddy.env na VPS e ajuste os valores.
# Lido pela unidade podcast-caddy.service; não versione o arquivo preenchido.

# Domínio público, com HTTPS automático
DOMAIN=editor.exemplo.com

# Endereço da API NestJS (podcast-api)
API_UPSTREAM=127.0.0.1:3000

# Pasta do app web exportado pelo deploy.sh (repositório em /srv/podcast-editor)
APP_WEB_ROOT=/srv/podcast-editor/app/dist
